# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override
# CLAUDE_MODEL=claude-opus-5-5

# Payments (Stripe). Leave STRIPE_SECRET_KEY empty for DEV mode: reports unlock without payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_URL=http://localhost:3000

# Expert review dashboard (/admin). The token is the admin password.
ADMIN_TOKEN=
# true = paid reports wait for specialist approval before the customer sees them
REVIEW_REQUIRED=false

# Razorpay (India: UPI, cards, netbanking). Takes priority over Stripe when set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Prices in paise (29900 = Rs 299)
PRICE_FULL=29900
PRICE_EXPERT=79900
REPORT_CURRENCY=inr

# Amazon Associates tag for product links (optional, earns commission)
AMAZON_ASSOCIATE_TAG=

# AI try-on (hairstyle / beard / glasses) - set one. ~Rs 3-4 per image.
FAL_KEY=
GEMINI_API_KEY=
# TRYON_PROVIDER=fal
# TRYON_QUOTA=6

# Optional SPIGA jaw model - legal review needed first (weights trained on WFLW research data).
# ENABLE_SPIGA=1

# --- Security / privacy ---
# 32-byte urlsafe-base64 Fernet key that encrypts stored reports. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a local key file is created in backend/.secrets/ (fine for development only).
DATA_ENCRYPTION_KEY=
# Anonymous (no account) reports older than this many days are deleted at startup; 0 disables.
RETENTION_DAYS=90
# Only set to 1 when behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=
# Extra allowed browser origins, comma separated (default: http://localhost:3000)
CORS_ORIGINS=
